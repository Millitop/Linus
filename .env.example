# Copy to .env and adjust for your deployment. Never commit the real .env.

FLASK_CONFIG=production
SECRET_KEY=change-me-to-a-long-random-value
DATABASE_URL=sqlite:////home/pi/linus/instance/gardskort.db
SITE_NAME=Fritidsgården

CARD_TOKEN_BYTES=32
RETRIEVAL_PIN_LENGTH=6
SCAN_DEBOUNCE_SECONDS=3
AUTO_CHECKOUT_TIME=18:00
LOG_RETENTION_DAYS=365

# A member's personal data is auto-erased after this many months with no
# check-in/out activity (see docs/gdpr-and-retention.md). 0 disables.
INACTIVE_MONTHS_BEFORE_ERASURE=12

# Future extension point only -- no cloud backend is implemented yet.
SYNC_ENABLED=false
